[user]
  name = Ben Hamill
  useConfigOnly = true
[alias]
  st = status
  co = checkout
  b = branch
  l = log -n10 --pretty=format:'• %C(yellow)%h%C(reset) %C(green)%ci%C(reset) %C(blue)%<(20,trunc)%an%C(reset)%C(bold blue)%<(40,trunc)%d%C(reset)%n  %<(78,trunc)%s%n'
  p = pull --prune
  fp = push --force-with-lease
  pr = pull-request
  amend = commit --amend --no-edit
[core]
  excludesfile = ~/.gitignore
  autocrlf = input
  attributesfile = ~/.gitattributes
  pager = diff-so-fancy | less --tabs=4 -RFX
[branch]
  autosetuprebase = always
[color]
  diff = true
  status = true
  ui = true
[merge]
  tool = vimdiff
[pull]
  default = current
	rebase = true
[push]
  default = current
  autoSetupRemote = true
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
